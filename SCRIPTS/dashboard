# load config from YAML file
config_path = os.path.expanduser('~/.config/dashboard.yml')
with open(config_path, 'r', encoding='utf-8') as config_file:
    CONFIG = yaml.safe_load(config_file)

REQUESTS_TIMEOUT = int(CONFIG['REQUESTS_TIMEOUT'])  # global

def print_title(text, output_format):
    """Print section title to screen"""
    if output_format == 'cli':
        print(f'{colorama.Fore.GREEN}####### {text}{colorama.Style.RESET_ALL}')
    else:
        print(f'${{color green}}===== {text} =====${{color1}}')

def format_bullet_point(symbol, color, text, output_format):
    """Format a string as a bullet point"""
    if output_format == 'cli':
        formatted = f'{color}{symbol}{colorama.Style.RESET_ALL}{text}'
    else:
        conky_colors = {
            colorama.Fore.GREEN: '${color green}',
            colorama.Fore.YELLOW: '${color yellow}',
            colorama.Fore.BLUE: '${color blue}',
            colorama.Fore.CYAN: '${color cyan}',
            colorama.Fore.MAGENTA: '${color magenta}',
            colorama.Fore.WHITE: '${color white}',
            colorama.Fore.RED: '${color red}',
        }
        conky_color = conky_colors.get(color, '${color0}')
        formatted = f'{conky_color}{symbol}${{color1}}{text}'
    return formatted

def format_list(items, max_lines):
    """Return the first items of a list as text on multiple lines.

    Args:
        items: List of strings to format
        max_lines: Maximum number of lines to return

    Returns:
        String with items joined by newlines
    """
    first_items = items[:max_lines]
    return "\n".join(first_items)

def get_imap_subjects(conn, folder, criterion):
    """get subjects of messages matching the search criterion in a folder"""
    prefix = folder.replace('INBOX/', '') + ': '
    #prefix = '' # hide folder names

    status, _ = conn.select(folder, readonly=True)
    if status != 'OK':
        return []
    _, imap_response = conn.search(None, criterion)
    message_uids = imap_response[0].split()
    messages = []
    for message_uid in message_uids:
        _, message_data = conn.fetch(message_uid, '(BODY.PEEK[HEADER])')
        for response_part in message_data:
            if isinstance(response_part, tuple):
                msg = email.message_from_bytes(response_part[1])
                decoded_header, encoding = email.header.decode_header(msg['Subject'])[0]
                if isinstance(decoded_header, bytes):
                    # Use 'utf-8' as default encoding if None is returned
                    effective_encoding = encoding if encoding is not None else 'utf-8'
                    subject = decoded_header.decode(effective_encoding).replace('\r', '').replace('\n', '')
                else:
                    subject = decoded_header.replace('\r', '').replace('\n', '')
                message = prefix + subject
                messages.append(message)
    return messages


def get_unread_mail(imap_accounts):
    """show a list of unread mail across multiple IMAP accounts"""
    all_messages = []
    for account in imap_accounts:
        try:
            all_messages.extend(_fetch_mail(account, 'UNSEEN'))
        except Exception:  # pylint: disable=broad-exception-caught
            pass
    return all_messages


def get_flagged_mail(imap_accounts):
    """show a list of flagged mail across multiple IMAP accounts"""
    all_messages = []
    for account in imap_accounts:
        try:
            all_messages.extend(_fetch_mail(account, 'FLAGGED'))
        except Exception:  # pylint: disable=broad-exception-caught
            pass
    return all_messages


def _fetch_mail(account, criterion):
    """Connect to one IMAP account and fetch messages matching criterion"""
    all_messages = []
    conn = imaplib.IMAP4_SSL(account['server'], account.get('port', 993))
    conn.login(account['username'], account['password'])
    folder_prefix = account['username'] + ': '
    for folder in account.get(criterion.lower() + '_folders', '').split(','):
        folder = folder.strip()
        if not folder:
            continue
        status, _ = conn.select(folder, readonly=True)
        if status != 'OK':
            continue
        _, imap_response = conn.search(None, '(' + criterion + ')')
        message_uids = imap_response[0].split()
        for message_uid in message_uids:
            _, message_data = conn.fetch(message_uid, '(BODY.PEEK[HEADER])')
            for response_part in message_data:
                if isinstance(response_part, tuple):
                    msg = email.message_from_bytes(response_part[1])  # pylint: disable=unsubscriptable-object
                    decoded_header, encoding = email.header.decode_header(msg['Subject'])[0]
                    if isinstance(decoded_header, bytes):
                        effective_encoding = encoding if encoding is not None else 'utf-8'
                        subject = decoded_header.decode(effective_encoding).replace('\r', '').replace('\n', '')
                    else:
                        subject = decoded_header.replace('\r', '').replace('\n', '')
                    all_messages.append(folder_prefix + folder + ': ' + subject)
    try:
        conn.close()
    except imaplib.IMAP4.error:
        pass
    conn.logout()
    return all_messages


def get_gitlab_issues(gitlab_token, *, assigned=False, created=False, repos=False, output_format):
    """Show a list of open gitlab issues.
    parameters: gitlab_token"""
    headers = {"PRIVATE-TOKEN": gitlab_token}
    BASE_URL = "https://gitlab.com/api/v4"
    gitlab_issues = []

    if assigned:
        params = {"state": "opened", "scope": "assigned_to_me"}
        url = f"{BASE_URL}/issues"
        response = requests.get(url, headers=headers, params=params, timeout=REQUESTS_TIMEOUT)
        response.raise_for_status()
        issues = response.json()
        for issue in issues:
            gitlab_issues.append(f'{issue["web_url"]} - {issue["title"]}')

    if created:
        print_title("gitlab issues created by you", output_format)
        params = {"state": "opened", "scope": "created_by_me"}
        url = f"{BASE_URL}/issues"
        response = requests.get(url, headers=headers, params=params, timeout=REQUESTS_TIMEOUT)
        response.raise_for_status()
        issues = response.json()
        for issue in issues:
            gitlab_issues.append(f'{issue["web_url"]} - {issue["title"]}')

    if repos:
        print_title("gitlab issues in your repos", output_format)
        projects_url = f"{BASE_URL}/projects"
        params = {"owned": "true", "per_page": "50", "with_issues_enabled": "true"}
        response = requests.get(projects_url, headers=headers, params=params, timeout=REQUESTS_TIMEOUT)
        response.raise_for_status()
        projects = response.json()

        for project in projects:
            project_id = project['id']
            issues_url = f"{BASE_URL}/projects/{project_id}/issues"
            params = {"state": "opened"}
            response = requests.get(issues_url, headers=headers, params=params, timeout=REQUESTS_TIMEOUT)
            response.raise_for_status()
            issues = response.json()

            if issues:
                for issue in issues:
                    gitlab_issues.append(f'{issue["web_url"]} - {issue["title"]}')

    return gitlab_issues


def get_gitea_issues(gitea_instance_url, gitea_token):
    """show a list of open gitea issues assigned to the specified user
    parameters: gitea_instance_url, gitea_token
    returns: list of issues URLs"""

    url = f"{gitea_instance_url}/api/v1/repos/issues/search"
    params = {
        'state': 'open',
        'assigned': "true",
        'direction': 'desc',
        'sort': 'updated'
    }
    headers = {'Authorization': f'token {gitea_token}'}

    try:
        response = requests.get(url, params=params, headers=headers, verify=False, timeout=REQUESTS_TIMEOUT)
        response.raise_for_status()
        issues = response.json()
        gitea_issues = []
        for issue in issues:
            gitea_issues.append(f'{issue["html_url"]} - {issue["title"]}')

    except requests.exceptions.RequestException as e:
        print(f"Error fetching issues: {e}")
        return []

    return gitea_issues


def get_github_issues(github_username, github_token):
    """Show a list of open github issues assigned to me, PRs assigned to me, and review requests.

    parameters: github_username, github_token
    returns: list of issues/PRs URLs
    """
    url = "https://api.github.com/search/issues"
    headers = {
        "Authorization": f"token {github_token}",
        "Accept": "application/vnd.github.v3+json",
    }
    seen = {}
    for query in [f"is:open assignee:{github_username}", f"is:open review-requested:{github_username}"]:
        params = {"q": query, "sort": "updated", "per_page": 100}
        try:
            response = requests.get(url, params=params, headers=headers, timeout=REQUESTS_TIMEOUT)
            response.raise_for_status()
            for item in response.json().get("items", []):
                seen[item["html_url"]] = item["title"]
        except requests.exceptions.RequestException as e:
            print(f"Error fetching github issues: {e}")
            return []
    return [f'{u} - {t}' for u, t in seen.items()]


def get_ttrss_marked(ttrss_url, ttrss_username, ttrss_password, ttrss_limit):
    """List TT-RSS starred articles"""
    # https://tt-rss.org/wiki/ApiReference

    ttrss_session = requests.Session()
    ttrss_login_data = json.dumps({
        "op": "login",
        "user": ttrss_username,
        "password": ttrss_password})
    ttrss_headers = {"Content-Type": "application/json"}
    try:
        response = ttrss_session.post(
            ttrss_url + '/api/',
            verify=False,
            headers=ttrss_headers,
            data=ttrss_login_data)
        auth = json.loads(response.text)
        session_id = auth['content']['session_id']

        # Get limit from environment variable or default to 20
        limit = int(ttrss_limit)

        ttrss_query_data = json.dumps({
            "sid": session_id,
            "op": "getHeadlines",
            "feed_id": -1, # starred articles
            "view_mode": "all_articles",
            "feed_dates": "date_reverse",
            "limit": limit})

        response = ttrss_session.post(
            ttrss_url + '/api/',
            verify=False,
            headers=ttrss_headers,
            data=ttrss_query_data)

        data = json.loads(response.text)
        ttrss_marked_articles = []
        for article in data['content']:
            ttrss_marked_articles.append(article['title'])

        return ttrss_marked_articles

    except requests.exceptions.RequestException as e:
        print(f"Error fetching tt-rss marked articles: {e}")
        return []



def get_caldav_events(caldav_url, caldav_username, caldav_password, max_days_in_future):
    """Fetch and format CalDAV events within a specified number of days in the future.

    Args:
        caldav_url: URL of the CalDAV server
        caldav_username: Username for authentication
        caldav_password: Password for authentication
        max_days_in_future: Maximum number of days to look ahead

    Returns:
        List of formatted event strings
    """
    events = []
    caldav_client = caldav.DAVClient(
        url=caldav_url,
        username=caldav_username,
        password=caldav_password,
        ssl_verify_cert=False,
        timeout=REQUESTS_TIMEOUT)
    try:
        caldav_principal = caldav_client.principal()
        caldav_calendar = caldav_principal.calendar(name='Personnel')
        assert caldav_calendar
        now = datetime.datetime.now(datetime.timezone.utc)
        caldav_events = caldav_calendar.search(
            start=now,
            end=now + datetime.timedelta(days=max_days_in_future),
            event=True,
            expand=True,
            sort_keys=('dtstart',))
        for event in caldav_events:
            ical_event = icalendar.Calendar.from_ical(event.data)
            for component in ical_event.walk():
                if component.name == "VEVENT":
                    summary = component.get('summary')
                    start_datetime = component.get('dtstart').dt
                    start = start_datetime.strftime('%a %d/%m %H:%M')
                    end_datetime = component.get('dtend').dt
                    duration_datetime = end_datetime - start_datetime
                    duration = 'h'.join(str(duration_datetime).split(':')[:2])
                    out_line = f'{start} {duration} {summary}'
                    events.append(out_line)
        return events

    except requests.exceptions.RequestException as e:
        print(f"Error fetching caldav tasks: {e}")
        return []


def get_caldav_tasks(caldav_url, caldav_username, caldav_password, max_priority=9, all_tasks=False):
    """Show a list of caldav tasks"""
    todos = []
    caldav_client = caldav.DAVClient(
        url=caldav_url,
        username=caldav_username,
        password=caldav_password,
        ssl_verify_cert=False,
        timeout=REQUESTS_TIMEOUT)
    try:
        caldav_principal = caldav_client.principal()
        caldav_calendar = caldav_principal.calendar(name='Personnel')
        assert caldav_calendar
        caldav_todos = caldav_calendar.todos(include_completed=False)
        now = datetime.datetime.now(datetime.timezone.utc)
        for todo in caldav_todos:
            summary = todo.vobject_instance.vtodo.summary.value
            try:
                priority = todo.vobject_instance.vtodo.priority.value
            except AttributeError:
                priority = "9"
            if not all_tasks:
                priority_int = int(priority)
                if priority_int > max_priority:
                    continue
                # Check if due date exists
                try:
                    _ = todo.vobject_instance.vtodo.due.value
                except AttributeError:
                    continue
            # Check if start date exists and is in the past
            due_date_str = ''
            try:
                due = todo.vobject_instance.vtodo.due.value
                due_date_str = due.strftime('%d-%m-%Y')
            except AttributeError:
                pass
            try:
                dtstart = todo.vobject_instance.vtodo.dtstart.value
                # Convert to datetime if it's a date object
                if isinstance(dtstart, datetime.date) and not isinstance(dtstart, datetime.datetime):
                    dtstart = datetime.datetime.combine(dtstart, datetime.time.min)
                # Make timezone-aware if naive
                if dtstart.tzinfo is None:
                    dtstart = dtstart.replace(tzinfo=datetime.timezone.utc)
                if dtstart > now:
                    continue
            except AttributeError:
                # If no start date, include the task
                pass

            if due_date_str:
                todos.append(f'{priority} {due_date_str} - {summary}')
            else:
                todos.append(f'{priority} {summary}')
        todos.sort()
        return todos

    except requests.exceptions.RequestException as e:
        print(f"Error fetching caldav tasks: {e}")
        return []


def get_shaarli_readlater(shaarli_url, shaarli_secret):
    """Fetch readlater links from Shaarli.
    
    Args:
        shaarli_url: URL of the Shaarli instance
        shaarli_secret: Shaarli secret key for API access
    
    Returns:
        List of formatted readlater link strings (URL - title)
    """
    client = ShaarliV1Client(shaarli_url, shaarli_secret)
    response = client.get_links({'limit': 99999999, 'searchtags': 'readlater -catalog'})
    links = response.json()
    readlater_links = [
        f'{link["url"]} - {link["title"]}'
        for link in links
    ]
    return readlater_links


def get_lutris_games():
    """Fetch unfinished games from Lutris library.
    
    Returns:
        List of game names
    """
    query = "SELECT name FROM games WHERE id NOT IN (SELECT DISTINCT game_id FROM games_categories) AND runner != 'libretro'"
    try:
        result = subprocess.run(
            ['sqlite3', os.path.expanduser('~/.local/share/lutris/pga.db'), query],
            capture_output=True,
            text=True,
            check=True
        )
        games = [line.strip() for line in result.stdout.strip().split('\n') if line.strip()]
        return games
    except subprocess.CalledProcessError as e:
        print(f"Error fetching Lutris games: {e}")
        return []
    except FileNotFoundError:
        print("Error: sqlite3 not found or Lutris database not found")
        return []


def get_firefox_bookmarks():
    """Fetch URLs from the Firefox bookmark folder named '???'.

    Returns:
        List of URL strings
    """
    profiles_dir = Path.home() / ".mozilla" / "firefox"
    profiles = list(profiles_dir.glob("*.default-esr"))
    if not profiles:
        return []

    db_path = profiles[0] / "places.sqlite"
    if not db_path.exists():
        return []

    with tempfile.NamedTemporaryFile(suffix=".sqlite", delete=False) as tmp:
        tmp_path = tmp.name
    shutil.copy2(db_path, tmp_path)

    conn = sqlite3.connect(tmp_path)
    cur = conn.cursor()

    cur.execute("SELECT id FROM moz_bookmarks WHERE title = ?", ("???",))
    row = cur.fetchone()
    if not row:
        conn.close()
        os.unlink(tmp_path)
        return []

    cur.execute("""
        SELECT p.url
        FROM moz_bookmarks b
        JOIN moz_places p ON p.id = b.fk
        WHERE b.parent = ? AND b.type = 1
        ORDER BY b.lastModified DESC
    """, (row[0],))

    urls = [r[0] or "(no URL)" for r in cur.fetchall()]

    conn.close()
    os.unlink(tmp_path)
    return urls


def check_mtime(file_path, warn_if_older_than_seconds, output_format):
    """check if a file last modification time is older than specified number of seconds"""
    if not os.path.exists(file_path):
        out = format_bullet_point('▧', colorama.Fore.RED, f'ERROR: {file_path} does not exist', output_format)
        print(out)
        return
    mod_time = os.path.getmtime(file_path)
    current_time = time.time()
    time_diff = current_time - mod_time
    mod_time_readable = datetime.datetime.fromtimestamp(mod_time).strftime('%Y-%m-%d %H:%M:%S')
    if time_diff > warn_if_older_than_seconds:
        out = format_bullet_point('▧', colorama.Fore.RED, f"ERROR: {file_path} last modified: {mod_time_readable})", output_format)
    else:
        out = format_bullet_point('▧', colorama.Fore.GREEN, f"{file_path} last modified: {mod_time_readable}", output_format)
    print(out)


def print_progress_bar(current, total, bar_length, output_format):
    """Print a progress bar"""
    if output_format == 'cli':
        green = colorama.Fore.GREEN
        white = colorama.Fore.WHITE
        reset = colorama.Style.RESET_ALL
    else: # conky
        green = '${color green}'
        white = '${color white}'
        reset = '${color1}'
    percent = float(current) / total
    blocks = '▅' * int(round(percent * bar_length))
    spaces = '▅' * (bar_length - len(blocks))
    print(f'{green}{blocks}{reset}{spaces}{white} ', end='', flush=True)

def calculate_progress(date_str, total_days):
    """Calculate progress for a date-based period"""
    try:
        start_date = datetime.datetime.strptime(date_str, "%Y-%m-%d")
        today = datetime.datetime.now().date()
        total_days = int(total_days)
        # If start date is in the future, return 100% progress
        if start_date.date() > today:
            return 0, 100
        days_elapsed = (today - start_date.date()).days
        # If we've passed the total period, return 100%
        if days_elapsed >= total_days:
            return days_elapsed, 100
        # Calculate progress percentage
        progress = (days_elapsed / total_days) * 100
        return days_elapsed, progress

    except ValueError:
        print("Error: Invalid date format. Please use YYYY-MM-DD.")
        return 0


def calculate_file_progress(file_path):
    """Calculate progress based on file modification time"""
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            hash_lines = 0
            other_lines = 0
            for line in f:
                # Stop at a marker line such as '#--------'
                if line.lstrip().startswith("#-"):
                    break
                stripped = line.rstrip("\n")
                if stripped.startswith("#"):
                    hash_lines += 1
                elif stripped.strip():
                    other_lines += 1
        total_lines = hash_lines + other_lines
        if total_lines == 0:
            print("Error: No non‑empty lines found in file")
            sys.exit(0)
        progress = (hash_lines / total_lines) * 100
    except FileNotFoundError:
        print(f"Error: File '{file_path}' not found.")
        sys.exit(1)
    return progress, hash_lines, total_lines

